# XARVIS CONFIGURATION EXAMPLE
SECRET_KEY=your_secret_key_here
USERNAME=admin
PASSWORD=your_password_here
CERT_PATH=/path/to/XarvisCore/xarvis_certificados/cert.pem
KEY_PATH=/path/to/XarvisCore/xarvis_certificados/key.pem
BACKUP_PATH=/path/to/backups

# SUPERVISOR
XARVIS_ENABLE_EXTENDED=false
XARVIS_MONITOR_INTERVAL=15
XARVIS_RESTART_BACKOFF_INITIAL=5
XARVIS_RESTART_BACKOFF_MAX=300
XARVIS_RESTART_STABLE_AFTER=60
XARVIS_SHUTDOWN_TIMEOUT=10
