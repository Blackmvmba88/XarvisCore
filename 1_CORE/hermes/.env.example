# Qdrant (si usas docker-compose)
QDRANT_URL=http://localhost:6333
# API
HERMES_API_BIND=0.0.0.0
HERMES_API_HOST=127.0.0.1
HERMES_API_PORT=8788
# WebUI
HERMES_WEB_HOST=127.0.0.1
HERMES_WEB_PORT=8787
# Opciones
START_QDRANT=0
DISK_THRESHOLD_GIB=15
# Modelos
RUNTIME_LLM=phi3:mini
EMBEDDINGS_MODEL=BAAI/bge-m3
# Seguridad (opcional)
HERMES_API_TOKEN=change_me_local_only
