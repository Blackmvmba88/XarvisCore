<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.personalmanager.backend</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>"cd \"$HOME/untitled folder 2\" && ./.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$HOME/Library/Logs/personalmanager/uvicorn.out</string>
  <key>StandardErrorPath</key>
  <string>$HOME/Library/Logs/personalmanager/uvicorn.err</string>
</dict>
</plist>
